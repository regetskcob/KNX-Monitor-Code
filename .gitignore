# See https://www.dartlang.org/guides/libraries/private-files

# Files and directories created by pub
.dart_tool/
.packages
build/

# Directory created by dartdoc
# If you don't generate documentation locally you can remove this line.
doc/api/

# dotenv environment variables file
.env*

# Avoid committing generated Javascript files:
*.dart.js
*.info.json      # Produced by the --dump-info flag.
*.js             # When generated by dart2js. Don't specify *.js if your
                 # project includes source files written in JavaScript.
*.js_
*.js.deps
*.js.map

.flutter-plugins
.flutter-plugins-dependencies

# IDE
.idea/
*.iml

# Local tests against real project files / installation
test_live/

# Home Assistant add-on: built web app (tool/build_ha_addon.sh)
ha-addon/knx_monitor/web/
ha-addon/knx_monitor/server/.dart_tool/

# Personal notes and release preparation (kept local)
ETS-Hausaufgaben.md
store/
key.properties
*.jks
*.keystore

# Vergleichsbilder fehlgeschlagener Golden-Tests (flutter test erzeugt sie)
test/failures/

# macOS
.DS_Store

# Instagram-Entwürfe (tool/social/): erzeugte Seiten und Bilder
teaser/content/social/
teaser/assets/images/social/
