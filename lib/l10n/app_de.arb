  "tourWelcomeTitle": "Sieh, was auf deinem Bus passiert.",
  "@tourWelcomeTitle": {
    "description": "Introduction, first card: title."
  },
  "tourWelcomeText": "Busclear hört am KNX-IP-Gateway mit und zeigt jedes Telegramm: wer sendet, an welche Gruppenadresse, mit welchem Wert. Diese Einführung führt durch die wichtigsten Stellen, mit dem Demo-Haus als Beispiel.",
  "@tourWelcomeText": {
    "description": "Introduction, first card: text."
  },
  "tourConnectTitle": "Verbinden in einem Schritt.",
  "@tourConnectTitle": {
    "description": "Introduction: connecting, title."
  },
  "tourConnectText": "Gateway suchen oder die Adresse eintragen, dann Verbinden. UDP passt zu jeder Schnittstelle; TCP, Routing und KNX IP Secure stehen unter Verbindungsart. Jede Anlage hat ihre Installation mit Gateway, Projekt und Einstellungen.",
  "@tourConnectText": {
    "description": "Introduction: connecting, text."
  },
  "tourChipSearch": "Gateway suchen",
  "@tourChipSearch": {
    "description": "Introduction chip: search for gateways."
  },
  "tourChipInstallations": "Installationen",
  "@tourChipInstallations": {
    "description": "Introduction chip: one installation per site."
  },
  "tourProjectTitle": "Mit dem ETS-Projekt bekommt jeder Wert einen Namen.",
  "@tourProjectTitle": {
    "description": "Introduction: ETS project, title."
  },
  "tourProjectText": "Importiere die .knxproj-Datei, auch mit Passwort, oder eine Gruppenadressen-CSV. Dann stehen Namen, Räume, Datentypen und Geräte da statt 1/2/3 und Rohbytes. Für KNX Secure kommt der Keyring dazu. Alles bleibt auf dem Gerät.",
  "@tourProjectText": {
    "description": "Introduction: ETS project, text."
  },
  "tourChipCsv": "Gruppenadressen-CSV",
  "@tourChipCsv": {
    "description": "Introduction chip: import a group address CSV."
  },
  "tourChipLocal": "Bleibt auf dem Gerät",
  "@tourChipLocal": {
    "description": "Introduction chip: no cloud."
  },
  "tourOverviewTitle": "Übersicht: jede Adresse als Karte.",
  "@tourOverviewTitle": {
    "description": "Introduction: overview, title."
  },
  "tourOverviewText": "Aktueller Wert, Anzahl und ein Mini-Verlauf, sortiert nach Räumen und Funktionen. Der Stern merkt Favoriten, die Nadel holt eine Sektion nach oben. Die Leiste oben zählt die Telegramme der letzten 60 Sekunden, der Stunde oder des Tages.",
  "@tourOverviewText": {
    "description": "Introduction: overview, text."
  },
  "tourObjectsTitle": "Objekte: was zusammengehört, steht zusammen.",
  "@tourObjectsTitle": {
    "description": "Introduction: objects, title."
  },
  "tourObjectsText": "Befehl und Rückmeldung eines Lichts, alle Werte eines Raumthermostats: in einer Karte. Aktoren erscheinen als Hutschienengeräte mit leuchtenden Kanal-LEDs.",
  "@tourObjectsText": {
    "description": "Introduction: objects, text."
  },
  "tourLiveTitle": "Live: jedes Telegramm der Reihe nach.",
  "@tourLiveTitle": {
    "description": "Introduction: live list, title."
  },
  "tourLiveText": "Zeit, Art (Schreiben, Lesen, Antwort), Absender, Ziel, Name und Wert. Auffälliges ist markiert, etwa eine falsche Länge oder ein ungewöhnlicher Routingzähler. Pause hält die Liste an, ohne etwas zu verlieren.",
  "@tourLiveText": {
    "description": "Introduction: live list, text."
  },
  "tourFilterTitle": "Filtern statt suchen.",
  "@tourFilterTitle": {
    "description": "Introduction: filter, title."
  },
  "tourFilterText": "Das Feld oben versteht Namen, Adressen, Geräte und Zeiten, auch zusammen. Gespeicherte Filter liegen hinter dem Lesezeichen im Feld.",
  "@tourFilterText": {
    "description": "Introduction: filter, text."
  },
  "tourChipFilterName": "Wetter",
  "@tourChipFilterName": {
    "description": "Introduction chip: example filter by name; must match something in the demo house (its weather station)."
  },
  "tourChipFilterSender": "von:1.1.10",
  "@tourChipFilterSender": {
    "description": "Introduction chip: example filter by sender; must match the filter syntax of the language."
  },
  "tourChipFilterTime": "zeit:14:05-14:10",
  "@tourChipFilterTime": {
    "description": "Introduction chip: example filter by time; must match the filter syntax of the language."
  },
  "tourDetailsTitle": "Details: lesen, schreiben, kommentieren.",
  "@tourDetailsTitle": {
    "description": "Introduction: details, title."
  },
  "tourDetailsText": "Ein Tipp auf eine Karte oder Zeile öffnet die Details: letzter Wert, Verlauf, Absender und verknüpfte Geräte. Von dort liest du den Wert neu, schreibst einen eigenen oder hängst einen Kommentar an.",
  "@tourDetailsText": {
    "description": "Introduction: details, text."
  },
  "tourHealthTitle": "Gesundheit: Ist die Anlage in Ordnung?",
  "@tourHealthTitle": {
    "description": "Introduction: health check, title."
  },
  "tourHealthText": "Ein Knopf liest alle Status-Adressen und wertet aus, was schon da ist: stumme Geräte, falsche Datentypen, auffällige Zyklen, Wiederholungen und Busqualität. Jeder Befund führt zur Adresse oder zum Gerät.",
  "@tourHealthText": {
    "description": "Introduction: health check, text."
  },
  "tourChipSilent": "Stumme Adressen",
  "@tourChipSilent": {
    "description": "Introduction chip: health finding."
  },
  "tourChipTypes": "Datentypen",
  "@tourChipTypes": {
    "description": "Introduction chip: health finding."
  },
  "tourChipCycles": "Zyklen",
  "@tourChipCycles": {
    "description": "Introduction chip: health finding."
  },
  "tourChipBusQuality": "Busqualität",
  "@tourChipBusQuality": {
    "description": "Introduction chip: health finding."
  },
  "tourRecordTitle": "Aufnehmen, kommentieren, melden.",
  "@tourRecordTitle": {
    "description": "Introduction: recording and comments, title."
  },
  "tourRecordText": "Der rote Punkt nimmt auf, mit Name und Notiz. Kommentare hängen an Telegrammen und Aufnahmen, mit Bildschirmfotos. „Fehler melden“ hält fest, wann etwas schiefging, und packt alles für deinen Elektriker zusammen.",
  "@tourRecordText": {
    "description": "Introduction: recording and comments, text."
  },
  "tourHistoryTitle": "Verlauf über Tage.",
  "@tourHistoryTitle": {
    "description": "Introduction: long-term history, title."
  },
  "tourHistoryText": "Der Langzeitverlauf hebt ganze Tage auf, im Add-on und auf der Busclear Box rund um die Uhr. Du spulst zurück, was nachts passiert ist, mit Zeitleiste je Gruppenadresse und Wiedergabe in 1- bis 60-facher Geschwindigkeit.",
  "@tourHistoryText": {
    "description": "Introduction: long-term history, text."
  },
  "tourChipTimeline": "Zeitleiste",
  "@tourChipTimeline": {
    "description": "Introduction chip: timeline per group address."
  },
  "tourChipPlayback": "Wiedergabe 1–60×",
  "@tourChipPlayback": {
    "description": "Introduction chip: playback speed."
  },
  "tourChartsTitle": "Diagramme: mehrere Werte, eine Zeitachse.",
  "@tourChartsTitle": {
    "description": "Introduction: charts, title."
  },
  "tourChartsText": "Bis zu acht Adressen zusammen, eine Achse je Einheit, Schaltwerte als eigene Zeilen. Gespeicherte Diagramme stehen als eigener Abschnitt in der Übersicht.",
  "@tourChartsText": {
    "description": "Introduction: charts, text."
  },
  "tourStatsTitle": "Statistik: Wer redet am meisten?",
  "@tourStatsTitle": {
    "description": "Introduction: statistics, title."
  },
  "tourStatsText": "Aktivste Adressen und Absender, Lastspitzen und eine Heatmap über Tage. Ein Tipp auf eine Spitze oder Zelle filtert den Monitor auf diese Zeit.",
  "@tourStatsText": {
    "description": "Introduction: statistics, text."
  },
  "tourWatchTitle": "Wächter und Alarme.",
  "@tourWatchTitle": {
    "description": "Introduction: watchers and alarms, title."
  },
  "tourWatchText": "Ein Wächter meldet sich mit Ton, sobald eine bestimmte Adresse sendet oder einen Wert erreicht. Alarm- und Störobjekte stehen oben in der Übersicht und schicken auf Wunsch Mitteilungen.",
  "@tourWatchText": {
    "description": "Introduction: watchers and alarms, text."
  },
  "tourChipSound": "Mit Ton",
  "@tourChipSound": {
    "description": "Introduction chip: watcher with sound."
  },
  "tourExportTitle": "Export in jedem Format.",
  "@tourExportTitle": {
    "description": "Introduction: export, title."
  },
  "tourExportText": "Telegramme als PDF, CSV oder für die ETS, Berichte von Gesundheit und Inbetriebnahme und ein ZIP mit allem. Die Export-Seite sammelt die letzten Dateien je Installation.",
  "@tourExportText": {
    "description": "Introduction: export, text."
  },
  "tourExpertTitle": "Ein Schalter, und die Werkstatt ist da.",
  "@tourExpertTitle": {
    "description": "Introduction: expert mode switch, title."
  },
  "tourExpertText": "Der Expertenmodus auf dem Verbindungsbildschirm oder unten im Menü schaltet die Werkzeuge für Inbetriebnahme und Fehlersuche ein, dazu Port, Tunneladresse und Verbindungsoptionen. Ohne ihn bleibt die App schlank, verloren geht nichts.",
  "@tourExpertText": {
    "description": "Introduction: expert mode switch, text."
  },
  "tourChipPort": "Port und Tunneladresse",
  "@tourChipPort": {
    "description": "Introduction chip: connection options in expert mode."
  },
  "tourBusmonTitle": "Busmonitor: jedes Frame.",
  "@tourBusmonTitle": {
    "description": "Introduction: bus monitor, title."
  },
  "tourBusmonText": "Rohframes mit Quittungen (ACK, NAK, BUSY), Wiederholungen und gestörten Telegrammen, die Absender in einer eigenen Spalte. Dafür muss die Schnittstelle den Busmonitor-Modus können.",
  "@tourBusmonText": {
    "description": "Introduction: bus monitor, text."
  },
  "tourChipAck": "ACK · NAK · BUSY",
