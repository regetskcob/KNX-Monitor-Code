  },
  "tourTopoTitle": "Topologie: Linien und Koppler.",
  "@tourTopoTitle": {
    "description": "Introduction: topology, title."
  },
  "tourTopoText": "Geräte nach Linien, Routingzähler, Tunnel und Verkehr über Koppler. Ein Gerät öffnet sein Blatt mit Kanälen, Tastern und Adressen.",
  "@tourTopoText": {
    "description": "Introduction: topology, text."
  },
  "tourMapTitle": "Kommunikationskarte: wer mit wem.",
  "@tourMapTitle": {
    "description": "Introduction: communication map, title."
  },
  "tourMapText": "Für jede Adresse, wer sendet und wer laut Projekt empfängt. Durchgezogen ist beobachtet, gestrichelt steht nur im Projekt.",
  "@tourMapText": {
    "description": "Introduction: communication map, text."
  },
  "tourCheckTitle": "Projekt-Abgleich.",
  "@tourCheckTitle": {
    "description": "Introduction: project check, title."
  },
  "tourCheckText": "Busverkehr gegen das ETS-Projekt: was fehlt, was unbekannt ist, was nie sendet, dazu die Flags der Objekte schon ohne Busverkehr.",
  "@tourCheckText": {
    "description": "Introduction: project check, text."
  },
  "tourCommTitle": "Inbetriebnahme und Diagnose.",
  "@tourCommTitle": {
    "description": "Introduction: commissioning and diagnostics, title."
  },
  "tourCommText": "Die Checkliste liest alle Status-Adressen nacheinander und hakt Antworten ab; was offen bleibt, prüfst du vor Ort und bekommst ein PDF-Protokoll. Die Diagnose findet Geräte im Programmiermodus, prüft Adressen und scannt Linien.",
  "@tourCommText": {
    "description": "Introduction: commissioning and diagnostics, text."
  },
  "tourChipProgMode": "Programmiermodus",
  "@tourChipProgMode": {
    "description": "Introduction chip: diagnostics finds devices in programming mode."
  },
  "tourChipLineScan": "Linienscan",
  "@tourChipLineScan": {
    "description": "Introduction chip: diagnostics scans a line."
  },
  "tourSendTitle": "Senden, auslösen, wiedergeben.",
  "@tourSendTitle": {
    "description": "Introduction: send, trigger, replay, title."
  },
  "tourSendText": "Senden wie im ETS-Gruppenmonitor, auch verzögert oder zyklisch. Trigger-Aufnahmen starten bei einem Wert, einer Störung oder einer Wiederholung, mit Vorlauf. Eine Aufnahme lässt sich auf den Bus zurückspielen, nach ausdrücklicher Bestätigung.",
  "@tourSendText": {
    "description": "Introduction: send, trigger, replay, text."
  },
  "tourBoxTitle": "Busclear Box für die Baustelle.",
  "@tourBoxTitle": {
    "description": "Introduction: Busclear Box, title."
  },
  "tourBoxText": "Ein Raspberry Pi, der rund um die Uhr mitschreibt und ein eigenes WLAN aufspannt. Gekoppelt wird per Aufkleber, den Verlauf holt die App direkt von der Box. Noch eine Vorschau.",
