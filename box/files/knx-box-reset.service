# Forgot the password: put knx-box-reset.txt on the boot partition from a PC
# (BOX_PASSWORD=…, WLAN_PASSWORD=…), restart the box. The file is removed.
[Unit]
Description=KNX Monitor Box: Passwörter von der SD-Karte setzen
After=local-fs.target knx-box-firstboot.service knx-box-data.service
Wants=knx-box-data.service
Before=knx-box.service
ConditionPathExists=|/boot/firmware/knx-box-reset.txt
ConditionPathExists=|/boot/knx-box-reset.txt

[Service]
Type=oneshot
ExecStart=/usr/local/lib/knx-box/secrets.sh --reset
# Same helper as knx-box-secrets.service, same sandbox; CAP_CHOWN also creates
# the data directory for the server user before its first start.
NoNewPrivileges=yes
ProtectHome=yes
PrivateTmp=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=CAP_SETUID CAP_SETGID CAP_DAC_READ_SEARCH CAP_DAC_OVERRIDE CAP_CHOWN CAP_FOWNER

[Install]
WantedBy=multi-user.target
