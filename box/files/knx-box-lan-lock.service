# Cable closed before any interface comes up and before SSH starts: loads the
# static table from lan.nft. knx-box-lan.service opens it later if the app or
# LAN_ACCESS allows it; it cannot run this early itself (it needs the data
# partition and first boot, which runs after NetworkManager).
[Unit]
Description=KNX Monitor Box: Kabel bis zur Freigabe gesperrt
Before=NetworkManager.service network-pre.target ssh.service knx-box-lan.service
Wants=network-pre.target

[Service]
Type=oneshot
ExecStart=/usr/sbin/nft -f /usr/local/lib/knx-box/lan.nft
RemainAfterExit=yes
NoNewPrivileges=yes
ProtectHome=yes
PrivateTmp=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=CAP_NET_ADMIN

[Install]
WantedBy=multi-user.target
