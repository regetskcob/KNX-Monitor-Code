# Requests from the server (new Wi-Fi password, clean up boot partition): it may
# touch neither the hotspot nor the boot partition, secrets.sh carries them out.
[Unit]
Description=KNX Monitor Box: Bitten zu den Passwörtern beobachten
After=knx-box-data.service

[Path]
PathExists=/var/lib/knx-box/wifi-request
PathExists=/var/lib/knx-box/sticker-scrub
Unit=knx-box-secrets.service

[Install]
WantedBy=multi-user.target
