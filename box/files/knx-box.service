# Busclear Box: server with continuous recording, web app and app pairing.
[Unit]
Description=Busclear Box
Documentation=https://busclear.de/box/
After=network-online.target knx-box-firstboot.service knx-box-data.service
Wants=network-online.target knx-box-data.service
# Do not start without first boot (passwords, Wi-Fi).
ConditionPathExists=/etc/knx-box/env

[Service]
User=knx-box
Group=knx-box
Environment=BOX=1 PORT=80 WEB_DIR=/opt/knx-box/web DATA_DIR=/var/lib/knx-box TZ=Europe/Berlin
# Real box: the first password is on the sticker and must be replaced (box_access.dart).
Environment=BOX_STICKER=1
# HTTPS with the box's own certificate (tls-cert.sh).
Environment=TLS_CERT=/etc/knx-box-tls/cert.pem TLS_KEY=/etc/knx-box-tls/key.pem TLS_PORT=443
# BOX_NAME, on the very first start BOX_PASSWORD (afterwards access.json applies).
EnvironmentFile=/etc/knx-box/env
ExecStart=/opt/knx-box/server
# Why it ended (out of memory, signal, watchdog), for the next start.
ExecStopPost=-/usr/local/lib/knx-box/last-exit.sh
StateDirectory=knx-box
StateDirectoryMode=0750
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
# Of the real devices only serial ones: ttyAMA* (KNX HAT on GPIO 14/15) and
# USB serial adapters (ttyUSB*, ttyACM*); otherwise only /dev/null and the like.
PrivateDevices=no
DevicePolicy=closed
DeviceAllow=char-ttyAMA rw
DeviceAllow=char-ttyUSB rw
DeviceAllow=char-ttyACM rw
SupplementaryGroups=dialout
ProtectKernelTunables=yes
ProtectControlGroups=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictNamespaces=yes
RestrictRealtime=yes
UMask=0077
# The boot partition holds knx-box.txt with the sticker and Wi-Fi passwords:
# hidden from the server. Only config.txt stays readable, for the HAT check
# (kberrySystem in kberry.dart reads the UART overlays from it).
TemporaryFileSystem=/boot:ro
BindReadOnlyPaths=-/boot/firmware/config.txt -/boot/config.txt
# No SystemCallFilter= or MemoryDenyWriteExecute=: the Dart VM may need
# writable and executable memory, and that cannot be tested without a Pi.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
Restart=always
RestartSec=3
# Time to write the history and to disconnect the tunnel (SIGTERM).
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
