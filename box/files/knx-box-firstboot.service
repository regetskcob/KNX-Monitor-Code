# Once on first boot: name, Wi-Fi, passwords (from knx-box.txt on the
# boot partition or random), set up the hotspot.
[Unit]
Description=Busclear Box: Erststart
After=local-fs.target NetworkManager.service
Wants=NetworkManager.service
Before=knx-box.service
ConditionPathExists=!/etc/knx-box/env

[Service]
Type=oneshot
ExecStart=/usr/local/lib/knx-box/firstboot.sh
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
