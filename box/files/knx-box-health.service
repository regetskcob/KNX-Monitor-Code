# Is the server still answering? Restarts it after three silent checks
# (health.sh). Started by knx-box-health.timer.
[Unit]
Description=Busclear Box: antwortet der Server?
After=knx-box.service

[Service]
Type=oneshot
ExecStart=/usr/local/lib/knx-box/health.sh
NoNewPrivileges=yes
ProtectHome=yes
PrivateTmp=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
