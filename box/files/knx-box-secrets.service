# See knx-box-secrets.path and secrets.sh. No RemainAfterExit, otherwise the
# next request would no longer start.
[Unit]
Description=KNX Monitor Box: WLAN-Passwort und Boot-Partition
After=knx-box-data.service

[Service]
Type=oneshot
ExecStart=/usr/local/lib/knx-box/secrets.sh
# Root helper: rewrites the hotspot profile, /etc/knx-box/env and the boot
# partition, asks NetworkManager over D-Bus (nmcli needs no capability), reads
# requests as the server user (CAP_SETUID, CAP_SETGID) and removes them from
# its 0750 directory (CAP_DAC_READ_SEARCH, CAP_DAC_OVERRIDE). CAP_CHOWN and
# CAP_FOWNER for files on the boot partition and the certificate directory.
NoNewPrivileges=yes
ProtectHome=yes
PrivateTmp=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=CAP_SETUID CAP_SETGID CAP_DAC_READ_SEARCH CAP_DAC_OVERRIDE CAP_CHOWN CAP_FOWNER
