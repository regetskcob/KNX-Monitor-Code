# pi-gen configuration of the Busclear Box (build-image.sh adds
# FIRST_USER_PASS and IMG_DATE). See https://github.com/RPi-Distro/pi-gen.
IMG_NAME="knx-box"
PI_GEN_RELEASE="Busclear Box"
RELEASE="trixie"
TARGET_HOSTNAME="knx-box"
LOCALE_DEFAULT="de_DE.UTF-8"
KEYBOARD_KEYMAP="de"
KEYBOARD_LAYOUT="German"
TIMEZONE_DEFAULT="Europe/Berlin"
# Maintenance account without password (SSH key from knx-box.txt only). pi-gen
# requires a password when renaming is disabled; build-image.sh sets
# a random one, the stage removes it again.
FIRST_USER_NAME="knxadmin"
DISABLE_FIRST_BOOT_USER_RENAME=1
ENABLE_SSH=0
DEPLOY_COMPRESSION="xz"
# Lite system (stage0–2) plus box; stage2 itself is not exported as an image.
STAGE_LIST="stage0 stage1 stage2 stage-knx-box"
