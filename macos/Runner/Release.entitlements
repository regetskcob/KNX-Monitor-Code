<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- Incoming sockets: KNXnet/IP over UDP (tunnel replies, routing multicast on 3671) and the
	     loopback listener of the browser sign-in (127.0.0.1, random port, closed after the
	     redirect). The app serves nothing else. -->
	<key>com.apple.security.network.server</key>
	<true/>
	<key>com.apple.security.print</key>
	<true/>
	<!-- Abgleich: privater iCloud-Container, siehe ios/Runner/KnxCloud.swift. -->
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.de.regetskcob.knx-monitor</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudDocuments</string>
	</array>
	<key>com.apple.developer.ubiquity-container-identifiers</key>
	<array>
		<string>iCloud.de.regetskcob.knx-monitor</string>
	</array>
</dict>
</plist>
